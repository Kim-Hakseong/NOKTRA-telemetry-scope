<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="using:Ts.App.Theme">

  <!--
    Noktra design tokens.

    Every colour comes from NoktraPalette so it is defined once. Repeating the hex values here
    would make the C# and the XAML drift apart the first time one of them is tuned.

    Type is Inter (SIL Open Font License 1.1), already carried by Avalonia.Fonts.Inter, so nothing
    new is licensed or shipped. Technical read-outs fall back to the platform monospace.
  -->

  <Color x:Key="NoktraCanvasTop">#BCBFC0</Color>
  <Color x:Key="NoktraCanvasBottom">#A9ADAE</Color>

  <SolidColorBrush x:Key="NoktraPanel" Color="{x:Static theme:NoktraPalette.Panel}" />
  <SolidColorBrush x:Key="NoktraPanelSunk" Color="{x:Static theme:NoktraPalette.PanelSunk}" />
  <SolidColorBrush x:Key="NoktraPanelEdge" Color="{x:Static theme:NoktraPalette.PanelEdge}" />
  <SolidColorBrush x:Key="NoktraLegalBar" Color="{x:Static theme:NoktraPalette.LegalBar}" />

  <SolidColorBrush x:Key="NoktraInk" Color="{x:Static theme:NoktraPalette.Ink}" />
  <SolidColorBrush x:Key="NoktraInkSoft" Color="{x:Static theme:NoktraPalette.InkSoft}" />
  <SolidColorBrush x:Key="NoktraMuted" Color="{x:Static theme:NoktraPalette.Muted}" />
  <SolidColorBrush x:Key="NoktraLine" Color="{x:Static theme:NoktraPalette.Line}" />
  <SolidColorBrush x:Key="NoktraLineFaint" Color="{x:Static theme:NoktraPalette.LineFaint}" />

  <SolidColorBrush x:Key="NoktraAccent" Color="{x:Static theme:NoktraPalette.Accent}" />
  <SolidColorBrush x:Key="NoktraAccentBright" Color="{x:Static theme:NoktraPalette.AccentBright}" />
  <SolidColorBrush x:Key="NoktraAccentWash" Color="{x:Static theme:NoktraPalette.AccentWash}" />

  <SolidColorBrush x:Key="NoktraWarn" Color="{x:Static theme:NoktraPalette.Warn}" />
  <SolidColorBrush x:Key="NoktraAlert" Color="{x:Static theme:NoktraPalette.Alert}" />
  <SolidColorBrush x:Key="NoktraOk" Color="{x:Static theme:NoktraPalette.Ok}" />
  <SolidColorBrush x:Key="NoktraReserved" Color="{x:Static theme:NoktraPalette.Reserved}" />

  <SolidColorBrush x:Key="NoktraOnInk" Color="{x:Static theme:NoktraPalette.OnInk}" />
  <SolidColorBrush x:Key="NoktraOnInkMuted" Color="{x:Static theme:NoktraPalette.OnInkMuted}" />

  <FontFamily x:Key="NoktraSans">Inter</FontFamily>
  <FontFamily x:Key="NoktraMono">monospace</FontFamily>

</ResourceDictionary>
